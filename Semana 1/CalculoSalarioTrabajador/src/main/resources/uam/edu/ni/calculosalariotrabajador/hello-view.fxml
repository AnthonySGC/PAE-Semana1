<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<VBox alignment="TOP_CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="uam.edu.ni.calculosalariotrabajador.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Calculadora de Salario"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Ingrese el salario del trabajador"/>
    <TextField fx:id="txtSalario"/>

    <Button text="Ingresar"
            fx:id="btnCalcular"
            onAction="#calcularSalario"/>

    <Label fx:id="lblSeguroSocial" text="Seguro social: "/>
    <Label fx:id="lblBono" text="Bono: "/>

    <Label fx:id="lblSalarioFinal" text="Salario con bono: "/>



</VBox>
